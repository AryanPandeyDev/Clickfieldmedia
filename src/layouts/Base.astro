---
import '../styles/global.css';
import { company, faqs } from '../data/site';
import Cursor from '../components/Cursor.astro';
interface Props { title?: string; description?: string; faqSchema?: boolean; noindex?: boolean; whatsapp?: boolean; }
const { title = 'Digital marketing & custom software | Clickfield Media', description = 'Marketing that brings people in. Software that helps your team follow through. Ads, creative, SEO, CRMs and portals, built in Lucknow for businesses across India.', faqSchema = true, noindex = false, whatsapp = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = Astro.site!.href.replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': ['Organization', 'ProfessionalService'], '@id': `${origin}/#organization`, name: company.name, url: origin, description, email: company.email, telephone: company.telephone,
      logo: { '@type': 'ImageObject', url: `${origin}/logo-navy.png`, width: 528, height: 164 },
      address: { '@type': 'PostalAddress', streetAddress: '3/245, Vijayant Khand, Gomti Nagar (behind Chandan Hospital)', addressLocality: 'Lucknow', addressRegion: 'Uttar Pradesh', postalCode: '226010', addressCountry: 'IN' },
      areaServed: [{ '@type': 'City', name: 'Lucknow' }, { '@type': 'City', name: 'Bengaluru' }, { '@type': 'Country', name: 'India' }, 'Worldwide'],
      sameAs: ['https://www.instagram.com/clickfield_media/', 'https://www.facebook.com/clickfieldmedia/', 'https://www.linkedin.com/company/clickfield-media/'],
      hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Marketing and software', itemListElement: ['Digital marketing', 'Meta and Google advertising', 'SEO and creative', 'Landing page development', 'Custom CRM development', 'Client portals and custom software'].map(name => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })) },
    },
    { '@type': 'WebSite', '@id': `${origin}/#website`, url: origin, name: company.name, inLanguage: 'en-IN' },
    ...(faqSchema ? [{ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  ],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9e1" />
    <!-- Google tag (gtag.js) for GA4, loaded directly (not via the GTM container).
         The `gtag` global is called by name by the click tracking and thank-you pages. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YJSFKS7SWF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-YJSFKS7SWF');
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WT4XLZBZ');
    </script>
    <!-- Meta Pixel: initialized once here so every page using Base records a
         PageView. Conversion events belong on their respective success pages. -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '30205907339081413');
      fbq('track', 'PageView');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${origin}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clickfield Media: More qualified enquiries. Not just clicks." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/og-image.png`} />
    <meta name="twitter:image:alt" content="Clickfield Media: More qualified enquiries. Not just clicks." />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WT4XLZBZ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=30205907339081413&ev=PageView&noscript=1" alt="" /></noscript>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {whatsapp && <a class="whatsapp-fab" href={`https://wa.me/${company.telephone.replace('+', '')}`} target="_blank" rel="noopener noreferrer" aria-label={`Chat with ${company.name} on WhatsApp`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
    </a>}
    <Cursor />
    <script>
      import { wireAnalytics } from '../scripts/analytics';
      wireAnalytics();
    </script>
    <script>
      // A mailto link does nothing on a desktop with no mail program set up, which
      // is common. With a mouse, open a Gmail draft in a new tab instead; phones
      // keep the mailto link, which opens their mail app.
      const desktop = window.matchMedia('(hover: hover) and (pointer: fine)');
      document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach(link => {
        link.addEventListener('click', event => {
          if (!desktop.matches) return;
          const to = decodeURIComponent(link.href.slice('mailto:'.length).split('?')[0]);
          event.preventDefault();
          window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}`, '_blank', 'noopener');
        });
      });
    </script>
  </body>
</html>
