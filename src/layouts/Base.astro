---
import '../styles/global.css';
import { company, faqs } from '../data/site';
import Cursor from '../components/Cursor.astro';
interface Props { title?: string; description?: string; faqSchema?: boolean; noindex?: boolean; }
const { title = 'Digital marketing & custom software | Clickfield Media', description = 'Marketing that brings people in. Software that helps your team follow through. Ads, creative, SEO, CRMs and portals, built in Lucknow for businesses across India.', faqSchema = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = Astro.site!.href.replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': ['Organization', 'ProfessionalService'], '@id': `${origin}/#organization`, name: company.name, url: origin, description, email: company.email, telephone: company.telephone,
      logo: { '@type': 'ImageObject', url: `${origin}/logo-navy.png`, width: 528, height: 164 },
      address: { '@type': 'PostalAddress', streetAddress: '3/245, Vijayant Khand, Gomti Nagar (behind Chandan Hospital)', addressLocality: 'Lucknow', addressRegion: 'Uttar Pradesh', postalCode: '226010', addressCountry: 'IN' },
      areaServed: [{ '@type': 'City', name: 'Lucknow' }, { '@type': 'City', name: 'Bengaluru' }, { '@type': 'Country', name: 'India' }, 'Worldwide'],
      sameAs: ['https://www.instagram.com/clickfield_media/', 'https://www.facebook.com/clickfieldmedia/', 'https://www.linkedin.com/company/clickfield-media/'],
      hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Marketing and software', itemListElement: ['Digital marketing', 'Meta and Google advertising', 'SEO and creative', 'Landing page development', 'Custom CRM development', 'Client portals and custom software'].map(name => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })) },
    },
    { '@type': 'WebSite', '@id': `${origin}/#website`, url: origin, name: company.name, inLanguage: 'en-IN' },
    ...(faqSchema ? [{ '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
  ],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee9e1" />
    <!-- Google tag (gtag.js). is:inline on both: the loader must stay an
         unbundled external script, and the config defines a global `gtag` that
         the click tracking and the thank-you page's own script call by name. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YJSFKS7SWF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-YJSFKS7SWF');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${origin}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clickfield Media: More qualified enquiries. Not just clicks." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/og-image.png`} />
    <meta name="twitter:image:alt" content="Clickfield Media: More qualified enquiries. Not just clicks." />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <Cursor />
    <script>
      import { wireAnalytics } from '../scripts/analytics';
      wireAnalytics();
    </script>
    <script>
      // A mailto link does nothing on a desktop with no mail program set up, which
      // is common. With a mouse, open a Gmail draft in a new tab instead; phones
      // keep the mailto link, which opens their mail app.
      const desktop = window.matchMedia('(hover: hover) and (pointer: fine)');
      document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach(link => {
        link.addEventListener('click', event => {
          if (!desktop.matches) return;
          const to = decodeURIComponent(link.href.slice('mailto:'.length).split('?')[0]);
          event.preventDefault();
          window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}`, '_blank', 'noopener');
        });
      });
    </script>
  </body>
</html>
