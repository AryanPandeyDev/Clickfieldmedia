---
// Ported from the real estate site so both Clickfield properties feel the same
// under the hand: a dot that keeps up with the pointer and a ring that lags
// behind it. The gap between the two is the whole effect.
//
// Desktop only, and only when reduced motion has not been asked for. The native
// cursor is hidden by the script rather than the stylesheet, so a touch device,
// or a visitor with the script blocked, always keeps its own pointer.
---

<div id="cur-ring" class="cur cur-ring" aria-hidden="true"></div>
<div id="cur-dot" class="cur cur-dot" aria-hidden="true"></div>

<style is:global>
  .cur {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
    transition: opacity 0.25s ease;
  }

  .cur-dot {
    height: 7px;
    width: 7px;
    border-radius: 999px;
    background: var(--color-orange);
  }

  .cur-ring {
    height: 34px;
    width: 34px;
    border-radius: 999px;
    border: 1.5px solid rgb(233 93 21 / 0.55);
    background: rgb(255 122 56 / 0.2);
    transition:
      opacity 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  /* Over the navy sections and the orange buttons, orange stops reading — the
     script measures the surface under the pointer and flips both to white. */
  .cur-dot.on-dark {
    background: #fff;
  }

  .cur-ring.on-dark {
    border-color: rgb(255 255 255 / 0.6);
    background: rgb(255 122 56 / 0.3);
  }

  .cur-ring.is-active {
    background: rgb(255 122 56 / 0.35);
    border-color: var(--color-orange);
  }

  .cur-ring.is-active.on-dark {
    background: rgb(255 122 56 / 0.42);
    border-color: rgb(255 255 255 / 0.85);
  }

  .cur.is-hidden {
    opacity: 0 !important;
  }

  /* Added by the script only once it has decided to take over. */
  html.has-cursor,
  html.has-cursor * {
    cursor: none;
  }

  /* Typing needs a real caret, so text fields keep the system cursor and the
     dot and ring get out of the way. */
  html.has-cursor input,
  html.has-cursor textarea {
    cursor: text;
  }

  html.has-cursor select,
  html.has-cursor iframe {
    cursor: auto;
  }
</style>

<script>
  const ring = document.getElementById('cur-ring');
  const dot = document.getElementById('cur-dot');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (ring && dot && fine.matches && !reduced.matches) {
    document.documentElement.classList.add('has-cursor');

    let px = window.innerWidth / 2;
    let py = window.innerHeight / 2;
    let dx = px;
    let dy = py;
    let rx = px;
    let ry = py;
    let dotScale = 1;
    let ringScale = 1;
    let dotTarget = 1;
    let ringTarget = 1;

    let lastTarget: Element | null = null;
    let resurface = false;
    let visible = false;
    let frame = 0;
    // The loop runs only while something is still catching up. Left running on
    // an idle page it would hold a requestAnimationFrame callback open forever,
    // which is exactly what this site's own frame check forbids.
    let running = false;

    const INTERACTIVE = 'a[href], button, summary, select, [role="button"], [data-open-enquiry]';
    const TEXT_FIELD = 'input, textarea';

    const luma = (r: number, g: number, b: number) => 0.299 * r + 0.587 * g + 0.114 * b;

    // Walks up for the first painted background and decides whether the dot and
    // ring need to invert to stay visible against it. Gradient surfaces leave
    // backgroundColor transparent, so the gradient's own stops are read too.
    const isDark = (start: Element | null) => {
      let node: Element | null = start;
      while (node && node !== document.documentElement) {
        // A surface painted by a separate layer (the industries colour bar) names itself.
        const hint = (node as HTMLElement).dataset?.cursorSurface;
        if (hint) return hint === 'dark';
        const style = getComputedStyle(node);
        const fill = style.backgroundColor.match(/[\d.]+/g);
        if (fill && fill.length >= 3 && (fill.length < 4 || Number(fill[3]) > 0.5)) {
          const [r, g, b] = fill.map(Number);
          return luma(r, g, b) < 145;
        }

        const stops = style.backgroundImage.match(/rgba?\([^)]+\)/g);
        if (stops?.length) {
          const total = stops.reduce((sum, stop) => {
            const [r, g, b] = stop.match(/[\d.]+/g)!.map(Number);
            return sum + luma(r, g, b);
          }, 0);
          return total / stops.length < 145;
        }

        node = node.parentElement;
      }
      return false;
    };

    const readSurface = (el: Element | null) => {
      const dark = isDark(el);
      ring.classList.toggle('on-dark', dark);
      dot.classList.toggle('on-dark', dark);
    };

    const applyTarget = (el: Element | null) => {
      lastTarget = el;
      readSurface(el);

      const overText = Boolean(el?.closest(TEXT_FIELD));
      ring.classList.toggle('is-hidden', overText);
      dot.classList.toggle('is-hidden', overText);

      const active = Boolean(el?.closest(INTERACTIVE));
      ring.classList.toggle('is-active', active);
      ringTarget = active ? 1.55 : 1;
      dotTarget = active ? 0.6 : 1;
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        px = e.clientX;
        py = e.clientY;

        if (!visible) {
          visible = true;
          ring.style.opacity = '1';
          dot.style.opacity = '1';
        }

        const el = e.target as Element | null;
        if (el !== lastTarget) applyTarget(el);
        start();
      },
      { passive: true },
    );

    // Scrolling moves a new surface under a stationary pointer, so the
    // light/dark reading has to be taken again.
    window.addEventListener('scroll', () => { resurface = true; start(); }, { passive: true });

    const press = (down: boolean) => {
      const active = ring.classList.contains('is-active');
      ringTarget = down ? (active ? 1.3 : 0.8) : active ? 1.55 : 1;
      dotTarget = down ? 1.6 : active ? 0.6 : 1;
      start();
    };

    window.addEventListener('pointerdown', () => press(true));
    window.addEventListener('pointerup', () => press(false));

    const hide = () => {
      visible = false;
      ring.style.opacity = '0';
      dot.style.opacity = '0';
    };

    document.addEventListener('pointerleave', hide);
    window.addEventListener('blur', hide);

    // A modal dialog is painted in the browser's top layer, above any z-index, so
    // the dot and ring would sit underneath it with the native cursor still off.
    // While one is open they live inside it, and go back to the body when it shuts.
    const home = ring.parentElement!;
    const mount = () => {
      const open = [...document.querySelectorAll('dialog')].filter(d => d.matches(':modal')).pop();
      const parent = open ?? home;
      if (ring.parentElement !== parent) parent.append(ring, dot);
    };
    const watch = new MutationObserver(mount);
    document.querySelectorAll('dialog').forEach(d => watch.observe(d, { attributes: true, attributeFilter: ['open'] }));

    const tick = () => {
      dx += (px - dx) * 0.42;
      dy += (py - dy) * 0.42;
      rx += (px - rx) * 0.13;
      ry += (py - ry) * 0.13;
      dotScale += (dotTarget - dotScale) * 0.2;
      ringScale += (ringTarget - ringScale) * 0.16;

      dot.style.transform = `translate3d(${dx}px, ${dy}px, 0) translate(-50%, -50%) scale(${dotScale})`;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%) scale(${ringScale})`;

      // Re-reading the surface is only worth a frame every so often, and only
      // once something has actually moved underneath.
      frame += 1;
      if (resurface && frame % 6 === 0) {
        resurface = false;
        readSurface(document.elementFromPoint(px, py));
      }

      // Half a pixel is below what the ring's own edge can show, so once
      // everything is inside that the chase is over until the next input.
      const settled =
        Math.abs(px - dx) < 0.5 &&
        Math.abs(py - dy) < 0.5 &&
        Math.abs(px - rx) < 0.5 &&
        Math.abs(py - ry) < 0.5 &&
        Math.abs(dotTarget - dotScale) < 0.005 &&
        Math.abs(ringTarget - ringScale) < 0.005;

      if (settled && !resurface) {
        running = false;
        return;
      }

      requestAnimationFrame(tick);
    };

    const start = () => {
      if (running) return;
      running = true;
      requestAnimationFrame(tick);
    };
  }
</script>
