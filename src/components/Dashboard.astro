---
const leads = [
  { name: 'Riya Sharma', initial: 'R', phone: '+91 •••• 2841', source: 'Google', status: 'New' },
  { name: 'Aditya Rao', initial: 'A', phone: '+91 •••• 6309', source: 'Meta', status: 'Assigned' },
  { name: 'Neha Kapoor', initial: 'N', phone: '+91 •••• 1752', source: 'Website', status: 'New' },
  { name: 'Kabir Shah', initial: 'K', phone: '+91 •••• 4026', source: 'Google', status: 'Assigned' },
];
---
<figure class="tablet-figure">
  <div class="tablet" data-dashboard data-arrivals="0" role="img" aria-label="Example CRM dashboard. New enquiries arrive from marketing into a shared sales pipeline.">
    <div class="dashboard" aria-hidden="true">
      <div class="dash-header">
        <span class="dash-title">Your pipeline</span>
        <span class="dash-live"><i></i> Connected</span>
      </div>
      <div class="dash-stats">
        <div class="dash-stat"><span>New leads today</span><div><strong data-lead-count>24</strong><svg viewBox="0 0 64 26"><path d="M1 22 9 18 18 20 27 11 36 15 45 7 53 9 63 2" /></svg></div></div>
        <div class="dash-stat"><span>Cost per enquiry</span><div><strong>₹380</strong><svg class="spark-coral" viewBox="0 0 64 26"><path d="M1 3 9 9 18 5 27 16 36 13 45 20 53 17 63 24" /></svg></div></div>
        <div class="dash-stat dash-stat-extra"><span>Active campaigns</span><div><strong>06</strong><svg class="spark-mint" viewBox="0 0 64 26"><path d="M1 21 12 21 12 15 30 15 30 10 49 10 49 4 63 4" /></svg></div></div>
      </div>
      <div class="dash-charts">
        <div class="area-chart">
          <div class="chart-heading"><span>Enquiries this week</span><span>Last 7 days</span></div>
          <svg class="area-svg" viewBox="0 0 290 73" preserveAspectRatio="none">
            <defs><linearGradient id="lead-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="chart-stop-start" /><stop offset="1" class="chart-stop-end" /></linearGradient></defs>
            <path class="chart-grid" d="M0 16H290M0 43H290M0 70H290" />
            <path class="area-fill" d="M0 60C18 60 20 47 40 48S65 62 84 43 108 50 126 35 154 40 171 23 198 33 213 19 235 24 252 9 275 16 290 3V73H0Z" />
            <path class="area-line" d="M0 60C18 60 20 47 40 48S65 62 84 43 108 50 126 35 154 40 171 23 198 33 213 19 235 24 252 9 275 16 290 3" />
          </svg>
          <div class="chart-days"><span>Mon</span><span>Wed</span><span>Fri</span><span>Sun</span></div>
        </div>
        <div class="source-chart"><span>By source</span><div class="source-bars"><div><i style="--bar:85%"></i><span>Meta</span></div><div><i style="--bar:64%"></i><span>Google</span></div><div><i style="--bar:36%"></i><span>Web</span></div></div></div>
      </div>
      <div class="leads-heading"><span>Incoming enquiries</span><span>Source <b>Status</b></span></div>
      <div class="lead-viewport">
        {leads.map((lead, index) => <div class="lead-row" style={`transform:translateY(${index * 100}%)`} data-lead-row>
          <span class="lead-avatar">{lead.initial}</span>
          <span class="lead-person"><b>{lead.name}</b><span>{lead.phone}</span></span>
          <span class="lead-source">{lead.source}</span>
          <span class:list={['lead-status', { assigned: lead.status === 'Assigned' }]}>{lead.status}</span>
        </div>)}
      </div>
    </div>
  </div>
  <figcaption><span>From the first click to your team’s next step.</span><button class="demo-toggle" type="button" data-toggle-dashboard aria-label="Pause dashboard updates">Pause <span aria-hidden="true">Ⅱ</span></button></figcaption>
</figure>
