---
import { testimonials } from '../data/site';

// A staggered deck: the centre card is the one being read, the rest fan out on
// either side at alternating tilts. Clicking any card brings it to the centre;
// the two buttons step through one at a time and are the keyboard route.
//
// Cards are laid out from their index in a rotating order rather than by
// reordering the DOM, so the reading order stays put for assistive technology
// while the visual order moves.
---

<div class="stagger" data-stagger role="group" aria-roledescription="carousel" aria-label="What clients say">
  <div class="stagger-stage" data-stage>
    {/* The cut corner is a clip-path, and clip-path also clips away any shadow
        the element casts — so the offset shadow lives on this outer wrapper and
        the clip lives on the face inside it. */}
    {testimonials.map(t => (
      <div class="stagger-card" data-card>
        <figure class="stagger-face">
          <span class="stagger-slash" aria-hidden="true"></span>
          <span class="stagger-avatar" aria-hidden="true">{t.initials}</span>
          <blockquote>{`“${t.quote}”`}</blockquote>
          <figcaption>{t.name} — {t.role}, {t.city}</figcaption>
        </figure>
      </div>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-status></p>
  <div class="stagger-controls">
    <button type="button" data-prev aria-label="Previous testimonial">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button type="button" data-next aria-label="Next testimonial">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-stagger]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const status = root?.querySelector<HTMLElement>('[data-status]');

  if (root && stage) {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-card]'));
    let order = cards.slice();
    let size = 365;

    const layout = () => {
      const count = order.length;
      order.forEach((card, index) => {
        // An odd-length deck has a true middle; an even one is offset by half
        // so that exactly one card still lands on zero.
        const position = count % 2 ? index - (count + 1) / 2 : index - count / 2;
        const centre = position === 0;
        // -1 % 2 is -1 and 2 % 2 is 0, so alternate cards tilt opposite ways
        // whichever side of the centre they are on.
        const odd = position % 2 !== 0;

        card.classList.toggle('is-centre', centre);
        card.style.width = `${size}px`;
        card.style.height = `${size}px`;
        card.style.zIndex = centre ? '10' : '0';
        card.style.transform = [
          'translate(-50%, -50%)',
          `translateX(${(size / 1.5) * position}px)`,
          `translateY(${centre ? -58 : odd ? 15 : -15}px)`,
          `rotate(${centre ? 0 : odd ? 2.5 : -2.5}deg)`,
        ].join(' ');

        if (centre && status) {
          const caption = card.querySelector('figcaption')?.textContent ?? '';
          status.textContent = `Showing ${caption}`;
        }
      });
    };

    const move = (steps: number) => {
      if (!steps) return;
      if (steps > 0) {
        for (let i = 0; i < steps; i += 1) {
          const first = order.shift();
          if (first) order.push(first);
        }
      } else {
        for (let i = 0; i > steps; i -= 1) {
          const last = order.pop();
          if (last) order.unshift(last);
        }
      }
      layout();
    };

    // On phones the deck steps itself one card at a time, forever, using the
    // same move as the buttons. It only runs while the deck is on screen, and
    // never for visitors who have asked for reduced motion (they keep the
    // buttons instead — see the matching media query in global.css).
    const autoQuery = window.matchMedia('(max-width: 639px) and (prefers-reduced-motion: no-preference)');
    let onScreen = false;
    let timer: number | undefined;

    const stopAuto = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const startAuto = () => {
      stopAuto();
      if (autoQuery.matches && onScreen && !document.hidden) {
        timer = window.setInterval(() => move(1), 3000);
      }
    };

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      startAuto();
    }).observe(root);
    autoQuery.addEventListener('change', startAuto);
    document.addEventListener('visibilitychange', startAuto);

    cards.forEach(card => {
      card.addEventListener('click', () => {
        // On phones the cards can't be tapped (see global.css); this guard
        // backs that up in case a click still reaches one.
        if (!sizeQuery.matches) return;
        const index = order.indexOf(card);
        const count = order.length;
        move(count % 2 ? index - (count + 1) / 2 : index - count / 2);
      });
    });

    root.querySelector('[data-prev]')?.addEventListener('click', () => move(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => move(1));

    const sizeQuery = window.matchMedia('(min-width: 640px)');
    const setSize = () => {
      size = sizeQuery.matches ? 365 : 278;
      layout();
    };

    setSize();
    sizeQuery.addEventListener('change', setSize);
  }
</script>
